# Local data and single-process runner.
MEETFLOW_DATA_DIR=data
MEETFLOW_START_WORKER=true

# A provider/model that supports Chat Completions function tools.
# No credentials are needed for the explicitly labelled offline demo.
MEETFLOW_MODEL_BASE_URL=https://api.openai.com/v1
MEETFLOW_MODEL_API_KEY=
MEETFLOW_MODEL_NAME=
MEETFLOW_MODEL_TIMEOUT=60
MEETFLOW_MAX_MODEL_CALLS=48
MEETFLOW_MAX_TOOL_CALLS=100
MEETFLOW_MAX_AGENT_STEPS=10
MEETFLOW_MAX_OUTPUT_TOKENS=3000
MEETFLOW_RUN_TIMEOUT=900

# Optional local ASR: install .[audio], then set a local model path or supported model name.
# Setting a model name can download model weights on first use.
MEETFLOW_ASR_MODEL=
MEETFLOW_ASR_DEVICE=cpu
MEETFLOW_MAX_UPLOAD_MB=100
