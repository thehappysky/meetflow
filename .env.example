# Local data and single-process runner.
MEETFLOW_DATA_DIR=data
MEETFLOW_START_WORKER=true
MEETFLOW_AUTH_ENABLED=true

# A provider/model that supports Chat Completions function tools.
# No credentials are needed for the explicitly labelled offline demo.
MEETFLOW_MODEL_BASE_URL=https://api.openai.com/v1
MEETFLOW_MODEL_API_KEY=
MEETFLOW_MODEL_NAME=
MEETFLOW_MODEL_API_PROFILE=openai
# Explicit local Ollama profile: base http://127.0.0.1:11434, profile ollama,
# model name required, API key optional. Uses native tools, think=false, num_predict.
# Alternative explicit profile ollama_json uses schema-constrained tool decisions.
# It still runs the same agents and gateways; no automatic protocol/demo fallback.
MEETFLOW_MODEL_CONTEXT_WINDOW=8192
# Optional matching tokenizer for local JSON-tool context accounting (never remote Python code).
MEETFLOW_MODEL_TOKENIZER_PATH=
MEETFLOW_MEETING_WORKFLOW=evidence_v1
MEETFLOW_EVIDENCE_COVERAGE=true
MEETFLOW_EVIDENCE_REFERENCE_PROTOCOL=refs_v1
MEETFLOW_EVIDENCE_PROMPT_REVISION=state_v2
MEETFLOW_MODEL_TIMEOUT=60
MEETFLOW_MODEL_TEMPERATURE=0
MEETFLOW_MODEL_SEED=2026
MEETFLOW_MAX_MODEL_CALLS=48
MEETFLOW_MAX_TOOL_CALLS=100
MEETFLOW_MAX_AGENT_STEPS=10
MEETFLOW_MAX_OUTPUT_TOKENS=3000
MEETFLOW_RUN_TIMEOUT=900

# Optional local ASR: install .[audio], then set a local model path or supported model name.
# Setting a model name can download model weights on first use.
MEETFLOW_ASR_MODEL=
MEETFLOW_ASR_DEVICE=cpu
MEETFLOW_MAX_UPLOAD_MB=100

# Optional report PDF font. Windows uses SimHei when present.
# On Linux, use a licensed TrueType CJK font file for embedded Chinese glyphs.
MEETFLOW_REPORT_FONT=
